# Obtain your own keys. Never share a populated .env.
ENHANCOR_API_KEY=
REPLICATE_API_TOKEN=
HF_TOKEN=
# 1 runs depth, masks and vocal separation on this machine instead of Replicate; see docs/LOCAL-MODELS.md.
LOCAL_PREPARATION=
# enhancor (default) or magnific. Magnific needs no webhook and no public media host; see docs/MAGNIFIC-API.md.
SEEDANCE_PROVIDER=enhancor
# Either the key itself, or a KEY=value file and the name of its line (keeps the secret out of this file).
MAGNIFIC_API_KEY=
MAGNIFIC_KEY_FILE=
MAGNIFIC_KEY_NAME=
# 480p or 720p
MAGNIFIC_DRAFT_RESOLUTION=720p
ENHANCOR_BASE_URL=https://apireq.enhancor.ai/api/seedance2.5/v1
# Required by Enhancor. Leave blank to use the automatic cloudflared callback tunnel.
ENHANCOR_WEBHOOK_URL=
# tmpfiles (temporary) or catbox (public persistent hosting)
MEDIA_HOST=tmpfiles
# Comma-separated fallback hosts. Catbox is public and persistent; leave empty to disable.
MEDIA_HOST_FALLBACKS=catbox
CATBOX_USERHASH=
